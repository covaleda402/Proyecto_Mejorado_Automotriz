# Copy this file to .env and replace every placeholder before any real
# deployment. These values are non-secret placeholders for local
# validation only.

# MySQL service
MYSQL_DATABASE=workshop
MYSQL_ROOT_PASSWORD=replace_with_secure_root_password
MYSQL_USER=workshop_app
MYSQL_PASSWORD=replace_with_secure_password
MYSQL_HOST=db
MYSQL_PORT=3306

